#!/usr/bin/env python3
"""Launch Codex with the current agterm session ID.

Run `codex-peer --test` for the built-in tests (Python 3.11 or newer).
Other arguments are forwarded to Codex, including explicit profiles.
"""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import uuid


def launch_codex():
    args = sys.argv[1:]
    session_id = os.environ.get("AGTERM_SESSION_ID")
    if session_id:
        uuid.UUID(session_id)
        # Keep trust in the base config unless the caller selects a profile.
        setting = "shell_environment_policy.set.AGTERM_SESSION_ID=" + json.dumps(session_id)
        args = ["-c", setting, *args]
    os.execvp("codex", ["codex", *args])


def main():
    if sys.argv[1:] == ["--test"]:
        return run_tests()
    try:
        launch_codex()
    except (OSError, ValueError) as error:
        print(f"codex-peer: {error}", file=sys.stderr)
        return 2
    return 0


def run_tests():
    """Check argument forwarding and config preservation without starting Codex."""
    import unittest

    try:
        import tomllib
    except ImportError:
        print("codex-peer: --test requires Python 3.11 or newer", file=sys.stderr)
        return 2

    wrapper = Path(__file__).resolve()
    session = "11111111-1111-4111-8111-111111111111"

    class WrapperTests(unittest.TestCase):
        def setUp(self):
            directory = tempfile.TemporaryDirectory()
            self.addCleanup(directory.cleanup)
            self.root = Path(directory.name)
            self.bin = self.root / "bin"
            self.bin.mkdir()
            self.config = self.root / "config with spaces"
            self.env = {k: v for k, v in os.environ.items() if not k.startswith("AGTERM_")}
            self.env.update({
                "PATH": str(self.bin) + os.pathsep + self.env["PATH"],
                "CODEX_HOME": str(self.config),
                "AGTERM_SESSION_ID": session,
            })
            stub = self.bin / "codex"
            stub.write_text("#!/usr/bin/env python3\nimport json,sys\nprint(json.dumps(sys.argv[1:]))\n")
            stub.chmod(0o755)
            agterm = self.bin / "agtermctl"
            agterm.write_text("#!/bin/sh\nexit 99\n")
            agterm.chmod(0o755)

        def run_wrapper(self, *args):
            return subprocess.run([sys.executable, str(wrapper), *args], env=self.env,
                                  cwd=self.root, capture_output=True, text=True)

        def check_args(self, *args):
            result = self.run_wrapper(*args)
            self.assertEqual(result.returncode, 0, result.stderr)
            actual = json.loads(result.stdout)
            self.assertEqual(actual[0], "-c")
            parsed = tomllib.loads(actual[1])
            self.assertEqual(parsed["shell_environment_policy"]["set"]["AGTERM_SESSION_ID"],
                             self.env["AGTERM_SESSION_ID"])
            self.assertEqual(actual[2:], list(args))

        def test_no_config_directory_needed(self):
            self.check_args("--approve-for-me", "--no-daemon", "resume", "--last", "a prompt with spaces")
            self.assertFalse(self.config.exists())

        def test_restart_and_new_pane_preserve_saved_trust(self):
            self.config.mkdir()
            base = self.config / "config.toml"
            profile = self.config / "agterm-existing.config.toml"
            contents = '[hooks.state.example]\ntrusted_hash = "saved"\ntrusted_content_hash = "content"\n'
            for path in (base, profile):
                path.write_text(contents)
                path.chmod(0o600)
            for current_session in (session, session, "22222222-2222-4222-8222-222222222222"):
                self.env["AGTERM_SESSION_ID"] = current_session
                self.env["AGTERM_PANE_ID"] = str(uuid.uuid4())
                self.check_args("resume", "--last")
            self.assertEqual(set(self.config.iterdir()), {base, profile})
            for path in (base, profile):
                self.assertEqual(path.read_text(), contents)
                self.assertEqual(path.stat().st_mode & 0o777, 0o600)

        def test_explicit_profiles_and_literal_prompts(self):
            for args in (("--profile", "chosen"), ("--profile=chosen",), ("-pchosen",),
                         ("--", "--profile=literal"), ("--", "--test")):
                with self.subTest(args=args):
                    self.check_args(*args)

        def test_outside_agterm_is_passthrough(self):
            del self.env["AGTERM_SESSION_ID"]
            args = ["--profile", "chosen", "resume", "thread"]
            result = self.run_wrapper(*args)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(json.loads(result.stdout), args)
            self.assertFalse(self.config.exists())

        def test_bad_session_id_does_not_launch(self):
            self.env["AGTERM_SESSION_ID"] = '../../bad"\nother = true'
            result = self.run_wrapper()
            self.assertEqual(result.returncode, 2)
            self.assertEqual(result.stdout, "")
            self.assertFalse(self.config.exists())

    suite = unittest.defaultTestLoader.loadTestsFromTestCase(WrapperTests)
    result = unittest.TextTestRunner(verbosity=2).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    sys.exit(main())
