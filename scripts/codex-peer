#!/usr/bin/env python3
"""Launch Codex with a config profile for the current agterm pane.

Run `codex-peer --test` for the built-in tests (Python 3.11 or newer).
Other arguments are forwarded to Codex.
"""

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import unicodedata
import uuid


def session_name(node, session_id):
    if isinstance(node, dict):
        if str(node.get("id", "")).lower() == session_id.lower():
            name = node.get("name")
            if isinstance(name, str) and name:
                return name
        children = node.values()
    elif isinstance(node, list):
        children = node
    else:
        return None
    for child in children:
        name = session_name(child, session_id)
        if name:
            return name
    return None


def launch_codex():
    args = sys.argv[1:]
    session_id = os.environ.get("AGTERM_SESSION_ID")
    if not session_id:
        os.execvp("codex", ["codex", *args])

    for arg in args:
        if arg == "--":
            break
        if arg == "--profile" or arg.startswith("--profile=") or arg.startswith("-p"):
            raise ValueError("codex-peer selects the profile; use codex directly with --profile")

    session_key = uuid.UUID(session_id).hex
    pane_id = os.environ.get("AGTERM_PANE_ID")
    if pane_id:
        pane_key = uuid.UUID(pane_id).hex
    else:
        role = os.environ.get("AGTERM_PANE", "main")
        role = re.sub(r"[^a-z0-9_-]", "-", role.lower()) or "main"
        pane_key = f"{session_key}-{role}"

    # tree lists workspaces and sessions.
    # --json returns data we can parse.
    command = ["agtermctl", "tree", "--json"]
    # --window selects the caller's window.
    # --socket selects the agterm instance that owns the session.
    for variable, option in (("AGTERM_WINDOW_ID", "--window"), ("AGTERM_SOCKET", "--socket")):
        value = os.environ.get(variable)
        if value:
            command.extend([option, value])
    try:
        result = subprocess.run(
            command,
            check=True,  # Raise an error if agtermctl exits with a nonzero status.
            capture_output=True,  # Capture stdout and stderr.
            text=True,  # Decode the captured output as text.
            timeout=5,  # Stop agtermctl if it takes more than five seconds.
        )
        name = session_name(json.loads(result.stdout), session_id)
        if not name:
            raise ValueError("session not found")
    except (OSError, subprocess.SubprocessError, ValueError):
        # Use a readable prefix when the session name is unavailable.
        # The pane key still identifies the profile.
        name = "session"
        print("codex-peer: session name unavailable; using the pane ID", file=sys.stderr)

    # Normalize Unicode forms, such as accented letters, before keeping ASCII text.
    # For example, "Café" becomes "Cafe".
    # Drop any remaining non-ASCII characters.
    name = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode()
    # Keep at most 40 allowed profile-name characters.
    # Use "session" if none remain.
    slug = re.sub(r"[^a-z0-9_-]+", "-", name.lower()).strip("-_")[:40] or "session"
    profile = f"agterm-{slug}-{pane_key}"
    config_dir = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    target = config_dir / f"{profile}.config.toml"
    content = (
        "# Generated by codex-peer; replaced on each launch.\n"
        "[shell_environment_policy.set]\n"
        f"AGTERM_SESSION_ID = {json.dumps(session_id)}\n"
    )

    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=config_dir,
                                         prefix=f".{profile}-", suffix=".tmp", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(content)
        os.replace(temporary, target)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

    os.execvp("codex", ["codex", "--profile", profile, *args])


def main():
    if sys.argv[1:] == ["--test"]:
        return run_tests()
    try:
        launch_codex()
    except (OSError, ValueError) as error:
        print(f"codex-peer: {error}", file=sys.stderr)
        return 2
    return 0


def run_tests():
    """Run wrapper tests with fake commands and temporary config directories."""
    import stat
    import textwrap
    import unittest

    try:
        import tomllib
    except ImportError:
        print("codex-peer: --test requires Python 3.11 or newer", file=sys.stderr)
        return 2

    WRAPPER = Path(__file__).resolve()
    SESSION = "11111111-1111-4111-8111-111111111111"
    PANE = "33333333-3333-4333-8333-333333333333"


    class WrapperTests(unittest.TestCase):
        def setUp(self):
            self.directory = tempfile.TemporaryDirectory()
            self.addCleanup(self.directory.cleanup)
            self.root = Path(self.directory.name)
            self.bin = self.root / "bin"
            self.bin.mkdir()
            self.config = self.root / "config with spaces"
            self.calls = self.root / "agterm-arguments.json"
            self.env = {k: v for k, v in os.environ.items() if not k.startswith("AGTERM_")}
            self.env.update({
                "PATH": str(self.bin) + os.pathsep + self.env["PATH"],
                "CODEX_HOME": str(self.config),
                "AGTERM_SESSION_ID": SESSION,
                "AGTERM_PANE_ID": PANE,
                "AGTERM_WINDOW_ID": "44444444-4444-4444-8444-444444444444",
                "AGTERM_SOCKET": "/tmp/socket with spaces",
                "CODEX_PEER_TEST_CALLS": str(self.calls),
                "CODEX_PEER_TEST_NAME": "+/readable",
            })
            self.stub("codex", "import json,sys\nprint(json.dumps(sys.argv[1:]))\n")
            self.stub("agtermctl", """
    import json,os,sys
    from pathlib import Path
    Path(os.environ['CODEX_PEER_TEST_CALLS']).write_text(json.dumps(sys.argv[1:]))
    if os.environ.get('CODEX_PEER_TEST_FAIL'):
        sys.exit(1)
    session = {'id': os.environ['AGTERM_SESSION_ID'], 'name': os.environ['CODEX_PEER_TEST_NAME']}
    other = {'id': '00000000-0000-0000-0000-000000000000', 'name': 'wrong-active', 'active': True}
    print(json.dumps({'ok': True, 'result': {'tree': [{'sessions': [other, session]}]}}))
    """)

        def stub(self, name, body):
            path = self.bin / name
            path.write_text("#!/usr/bin/env python3\n" + textwrap.dedent(body))
            path.chmod(0o755)

        def run_wrapper(self, *args):
            return subprocess.run([sys.executable, str(WRAPPER), *args], env=self.env,
                                  cwd=self.root, capture_output=True, text=True)

        def check_profile(self, result):
            self.assertEqual(result.returncode, 0, result.stderr)
            args = json.loads(result.stdout)
            self.assertEqual(args[0], "--profile")
            path = self.config / (args[1] + ".config.toml")
            parsed = tomllib.loads(path.read_text())
            self.assertEqual(parsed, {"shell_environment_policy": {"set": {"AGTERM_SESSION_ID": SESSION}}})
            self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o600)
            self.assertFalse(list(self.config.glob("*.tmp")))
            return args, path

        def test_name_target_arguments_and_base_config(self):
            self.config.mkdir()
            base = self.config / "config.toml"
            base.write_text('model = "keep-me"\n')
            args, path = self.check_profile(self.run_wrapper("resume", "thread-id", "a prompt with spaces"))
            self.assertEqual(args, ["--profile", "agterm-readable-" + PANE.replace("-", "").lower(),
                                    "resume", "thread-id", "a prompt with spaces"])
            self.assertEqual(base.read_text(), 'model = "keep-me"\n')
            self.assertEqual(json.loads(self.calls.read_text()), ["tree", "--json", "--window",
                             self.env["AGTERM_WINDOW_ID"], "--socket", self.env["AGTERM_SOCKET"]])
            self.check_profile(self.run_wrapper("resume", "thread-id"))
            self.assertEqual(len(list(self.config.glob("agterm-*.config.toml"))), 1)

        def test_two_panes_with_same_session_name(self):
            first, _ = self.check_profile(self.run_wrapper())
            self.env["AGTERM_PANE_ID"] = "22222222-2222-4222-8222-222222222222"
            second, _ = self.check_profile(self.run_wrapper())
            self.assertNotEqual(first[1], second[1])
            self.assertEqual(len(list(self.config.glob("*.config.toml"))), 2)

        def test_missing_pane_id_uses_session_and_role(self):
            del self.env["AGTERM_PANE_ID"]
            self.env["AGTERM_PANE"] = "right"
            args, _ = self.check_profile(self.run_wrapper())
            self.assertTrue(args[1].endswith(SESSION.replace("-", "").lower() + "-right"))

        def test_agterm_failure_keeps_the_requested_environment(self):
            self.env["CODEX_PEER_TEST_FAIL"] = "1"
            args, _ = self.check_profile(self.run_wrapper())
            self.assertTrue(args[1].startswith("agterm-session-"))

        def test_unicode_and_path_characters_in_name(self):
            self.env["CODEX_PEER_TEST_NAME"] = '../../ Café / "$(touch pwned)"'
            args, path = self.check_profile(self.run_wrapper())
            self.assertRegex(args[1], r"^[a-z0-9_-]+$")
            self.assertEqual(path.parent, self.config)
            self.assertFalse((self.root / "pwned").exists())

        def test_outside_agterm_is_passthrough(self):
            del self.env["AGTERM_SESSION_ID"]
            result = self.run_wrapper("--profile", "my-profile", "resume", "thread")
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(json.loads(result.stdout), ["--profile", "my-profile", "resume", "thread"])
            self.assertFalse(self.calls.exists())
            self.assertFalse(self.config.exists())

        def test_explicit_profile_is_rejected_before_writing(self):
            for flag in ["-p", "-pother", "--profile", "--profile=other"]:
                with self.subTest(flag=flag):
                    result = self.run_wrapper(flag, "other")
                    self.assertEqual(result.returncode, 2)
                    self.assertIn("selects the profile", result.stderr)
            self.assertFalse(self.config.exists())
            self.assertFalse(self.calls.exists())

        def test_option_terminator_preserves_prompt(self):
            for prompt in ["--profile=literal", "--test"]:
                with self.subTest(prompt=prompt):
                    args, _ = self.check_profile(self.run_wrapper("--", prompt))
                    self.assertEqual(args[2:], ["--", prompt])

        def test_bad_session_id_stops_before_any_write(self):
            self.env["AGTERM_SESSION_ID"] = "../../bad"
            result = self.run_wrapper()
            self.assertEqual(result.returncode, 2)
            self.assertFalse(self.config.exists())
            self.assertFalse(self.calls.exists())

        def test_failed_profile_write_does_not_launch_codex(self):
            self.config.write_text("not a directory")
            result = self.run_wrapper()
            self.assertEqual(result.returncode, 2)
            self.assertEqual(result.stdout, "")


    suite = unittest.defaultTestLoader.loadTestsFromTestCase(WrapperTests)
    result = unittest.TextTestRunner(verbosity=2).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    sys.exit(main())
